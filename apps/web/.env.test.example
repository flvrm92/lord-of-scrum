# E2E test environment — copy to .env.test and fill in.
#
# IMPORTANT: DATABASE_URL must point at a DIFFERENT database than your dev one.
# The E2E suite runs `prisma migrate deploy` + `prisma db seed` against it and
# creates real sessions, participants, rounds and votes.
# Use a separate Neon/Supabase branch, or a local Postgres:
#   docker run -d -p 5433:5432 -e POSTGRES_PASSWORD=postgres --name los-test postgres:16
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres"

# Database (must differ from .env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/postgres"

# NextAuth — the E2E suite forges a session cookie signed with this secret,
# so it must match the value the app server runs with.
NEXTAUTH_SECRET="e2e-test-secret-do-not-use-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OAuth — left empty on purpose. The auth specs mint a JWT session cookie
# directly instead of going through a provider, so no real OAuth app is needed.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Ably — optional. The core suite is realtime-independent; set a real key only
# to run the opt-in `realtime` project (`playwright test --project=realtime`).
ABLY_API_KEY=""

# Cron secret (exercised by the cron spec)
CRON_SECRET="e2e-cron-secret"
